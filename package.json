{
  "name": "impostor",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:ui": "jest --runInBand",
    "test:e2e": "playwright test",
    "words:validate": "node scripts/validate-words.mjs",
    "words:integrity": "node scripts/validate-words.mjs --integrity-only",
    "export:check": "expo export --platform all",
    "build": "pnpm words:validate && expo export --platform all",
    "build:web": "pnpm words:integrity && expo export --platform web && node scripts/prepare-netlify.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm test:ui && pnpm words:validate",
    "assets:generate": "node scripts/generate-assets.mjs",
    "eas-build-post-install": "pnpm words:validate"
  },
  "dependencies": {
    "expo": "~57.0.20",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "expo-crypto": "~57.0.2",
    "expo-audio": "~57.0.4",
    "expo-screen-capture": "~57.0.2",
    "expo-haptics": "~57.0.2",
    "expo-font": "~57.0.3",
    "expo-dev-client": "~57.0.18",
    "expo-system-ui": "~57.0.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-dom": "19.2.3",
    "react-native-web": "~0.21.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@expo/vector-icons": "^15.0.2",
    "@babel/runtime": "^7.28.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3",
    "jest-expo": "~57.0.5",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.14",
    "react-test-renderer": "19.2.3",
    "@testing-library/react-native": "^13.3.3",
    "vitest": "^4.0.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.0",
    "@eslint/js": "^9.39.0",
    "typescript-eslint": "^8.59.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.4.0",
    "prettier": "^3.8.0",
    "@babel/core": "^7.28.4"
  }
}
